{# The memo of what is declared to the conseil de l'Ordre (Base\Lawyer\Controller\Admin\DeclarationController). #}
{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ 'admin.declaration.title'|trans({}, 'lawyer') }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <span class="admin-header-icon"><i class="fa-solid fa-envelope-open-text"></i></span>
    <div class="admin-header-titles">
        <h1>{{ 'admin.declaration.title'|trans({}, 'lawyer') }}</h1>
        <div class="admin-header-subtitle">{{ 'admin.declaration.lead'|trans({}, 'lawyer') }}</div>
    </div>
</div>
{% endblock %}

{% block content %}
<style>
    .ld { display: grid; gap: 1rem; max-width: 60rem; }
    .ld .card { padding: 1rem 1.1rem; }
    .ld h2 { font-size: 1rem; margin: 0 0 .2rem; }
    .ld .rule { margin: 0 0 .7rem; font-size: .82rem; opacity: .75; }
    .ld table { width: 100%; font-size: .9rem; }
    .ld th, .ld td { padding: .4rem .5rem; border-bottom: 1px solid rgba(127,127,127,.25); text-align: left; vertical-align: top; }
    .ld .is-ok { color: #1a7f37; } .ld .is-warning { color: #9a6700; } .ld .is-missing { color: #cf222e; }
    .ld ul { margin: 0; padding-left: 1.1rem; }
    @media print { .admin-sidebar, .admin-topbar, .ld-print { display: none !important; } }
</style>
<div class="ld">
    <div class="card">
        <h2>{{ 'admin.declaration.to'|trans({}, 'lawyer') }}</h2>
        <p>{% if record.bar %}{{ 'admin.declaration.to_bar'|trans({bar: record.bar}, 'lawyer') }}{% else %}<span class="is-missing">{{ 'compliance.order_bar_advice'|trans({}, 'lawyer') }}</span>{% endif %}
        — {% if record.declaredAt %}<span class="is-ok">{{ 'admin.declaration.declared'|trans({date: record.declaredAt|format_datetime('long', 'none', locale=app.request.locale)}, 'lawyer') }}</span>{% else %}<span class="is-missing">{{ 'admin.declaration.not_declared'|trans({}, 'lawyer') }}</span>{% endif %}</p>
        <p class="ld-print"><button type="button" class="btn btn-secondary" onclick="window.print()"><i class="fa-solid fa-print"></i> {{ 'admin.declaration.print'|trans({}, 'lawyer') }}</button> <a class="btn btn-secondary" href="{{ path('admin_settings') }}">{{ 'admin.declaration.settings'|trans({}, 'lawyer') }}</a></p>
    </div>

    <div class="card">
        <h2>{{ 'admin.declaration.domains'|trans({}, 'lawyer') }}</h2>
        <p class="rule">{{ 'admin.declaration.domains_rule'|trans({}, 'lawyer') }}</p>
        <table>
            {% for domain, verdict in verdicts %}
            <tr><td><code>{{ domain }}</code></td><td class="is-{{ verdict == 'ok' ? 'ok' : (verdict == 'generic' ? 'missing' : 'warning') }}">{{ ('admin.declaration.verdict.' ~ verdict)|trans({}, 'lawyer') }}</td></tr>
            {% else %}
            <tr><td class="is-warning">{{ 'compliance.domain_none'|trans({}, 'lawyer') }}</td></tr>
            {% endfor %}
        </table>
    </div>

    <div class="card">
        <h2>{{ 'admin.declaration.mentions'|trans({}, 'lawyer') }}</h2>
        <p class="rule">{{ 'admin.declaration.mentions_rule'|trans({}, 'lawyer') }}</p>
        <table>
            <thead><tr><th>{{ 'admin.field.member'|trans({}, 'lawyer') }}</th><th>{{ 'admin.field.specialisations'|trans({}, 'lawyer') }}</th><th>{{ 'admin.field.dominant_fields'|trans({}, 'lawyer') }}</th></tr></thead>
            {% for attorney in attorneys %}
            <tr>
                <td>{{ attorney.member.displayName }}<br><small>{{ attorney.member.title }}</small></td>
                <td>{% for specialisation in attorney.specialisations %}{{ specialisation.label }}<br>{% else %}—{% endfor %}{% if attorney.qualification %}<small>{{ attorney.qualification }}</small>{% endif %}</td>
                <td>{{ attorney.dominantFields ? attorney.dominantFields|join(', ') : '—' }}</td>
            </tr>
            {% else %}
            <tr><td colspan="3">—</td></tr>
            {% endfor %}
        </table>
    </div>

    <div class="card">
        <h2>{{ 'admin.declaration.pages'|trans({}, 'lawyer') }}</h2>
        <p class="rule">{{ 'admin.declaration.pages_rule'|trans({}, 'lawyer') }}</p>
        <ul>
            {% for area in areas %}<li><a href="{{ path('lawyer_area', {slug: area.slug}) }}" target="_blank" rel="noopener">{{ area.name }}</a> — {{ area.summary }}</li>{% endfor %}
            <li><a href="{{ path('lawyer_fees') }}" target="_blank" rel="noopener">{{ 'fees.title'|trans({}, 'lawyer') }}</a></li>
        </ul>
    </div>

    <div class="card">
        <h2>{{ 'admin.declaration.keep'|trans({}, 'lawyer') }}</h2>
        <ul>
            <li>{{ 'admin.declaration.keep_links'|trans({}, 'lawyer') }}</li>
            <li>{{ 'admin.declaration.keep_ads'|trans({}, 'lawyer') }}</li>
            <li>{{ 'admin.declaration.keep_change'|trans({}, 'lawyer') }}</li>
        </ul>
        <p class="rule">{{ 'admin.declaration.reserve'|trans({}, 'lawyer') }}</p>
    </div>
</div>
{% endblock %}
